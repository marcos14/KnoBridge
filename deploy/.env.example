# KnoBridge Docker Compose settings. Copy to deploy/.env (ignored by git) and adjust.
# Every variable is optional: docker-compose.yml has the same defaults, so `up` works without .env.
#
# !!! DEVELOPMENT ONLY !!! The credentials below are public, well-known values for a local
# environment. Never use them in a shared, staging or production environment.

# Interface the host ports bind to. 127.0.0.1 keeps every service off the network;
# use 0.0.0.0 only if you really need to reach them from another machine.
BIND_ADDRESS=127.0.0.1

# Host ports (change any that are already taken on your machine).
POSTGRES_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
FRONTEND_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Postgres superuser (used only by the init script and for manual administration). DEV ONLY.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres-dev

# KnoBridge application database and role, created on the first start. DEV ONLY.
# Changing them after the first `up` requires `down -v` (the init script runs on an empty volume only).
KNOBRIDGE_DB_NAME=knobridge
KNOBRIDGE_DB_USER=knobridge
KNOBRIDGE_DB_PASSWORD=knobridge-dev

# Role that owns the Temporal databases (temporal, temporal_visibility). DEV ONLY.
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal-dev

# Temporal namespace registered by auto-setup and used by the worker.
TEMPORAL_NAMESPACE=default
KNOBRIDGE_TEMPORAL_TASK_QUEUE=knobridge

# MinIO (S3-compatible object storage) root credentials, also the console login. DEV ONLY.
MINIO_ROOT_USER=knobridge
MINIO_ROOT_PASSWORD=knobridge-dev
# MinIO image (pinned release). Override only to test another release.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# Backend log level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
KNOBRIDGE_LOG_LEVEL=INFO

# Secret that signs CSRF tokens (32+ characters). DEV ONLY: this is the public development
# default; anywhere beyond your machine, replace it with the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KNOBRIDGE_SECRET_KEY=dev-only-insecure-secret-key-change-me

# URL of the admin panel as the browser sees it; links in e-mails start here.
# Keep the port in sync with FRONTEND_PORT.
KNOBRIDGE_PUBLIC_BASE_URL=http://localhost:5173

# Sender of transactional e-mails. In this environment every e-mail goes to Mailpit
# (http://localhost:8025) and nothing is delivered to real mailboxes.
KNOBRIDGE_SMTP_FROM=KnoBridge <no-reply@knobridge.local>
