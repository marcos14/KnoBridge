{
  "components": {
    "schemas": {
      "AuditAction": {
        "enum": [
          "setup.completed",
          "user.created",
          "user.suspended",
          "user.reactivated",
          "workspace.created",
          "workspace.updated",
          "workspace.suspended",
          "auth.login.succeeded",
          "auth.login.failed",
          "auth.logout.succeeded",
          "auth.sessions.revoked",
          "auth.password.changed",
          "auth.password_reset.requested",
          "auth.password_reset.completed",
          "auth.email.verified",
          "auth.email_verification.requested",
          "user.profile.updated",
          "membership.invited",
          "membership.invitation.accepted",
          "membership.role.changed",
          "membership.removed"
        ],
        "title": "AuditAction",
        "type": "string"
      },
      "AuditEventOut": {
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "actor_user_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor User Id"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ip_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Address"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Id"
          },
          "target_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Type"
          }
        },
        "required": [
          "id",
          "action",
          "actor_user_id",
          "target_type",
          "target_id",
          "details",
          "ip_address",
          "occurred_at"
        ],
        "title": "AuditEventOut",
        "type": "object"
      },
      "AuditEventPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditEventOut"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "AuditEventPage",
        "type": "object"
      },
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 1024,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "CsrfResponse": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "CsrfResponse",
        "type": "object"
      },
      "ForgotPasswordRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ForgotPasswordRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LiveResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "LiveResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "is_superadmin": {
            "title": "Is Superadmin",
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          },
          "workspaces": {
            "items": {
              "$ref": "#/components/schemas/UserWorkspaceOut"
            },
            "title": "Workspaces",
            "type": "array"
          }
        },
        "required": [
          "user",
          "is_superadmin",
          "workspaces"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "ProfileUpdate": {
        "description": "Fields to change; omitted (or null) fields keep their value.",
        "properties": {
          "locale": {
            "anyOf": [
              {
                "maxLength": 16,
                "pattern": "^[a-z]{2,3}(-([A-Z]{2}|[0-9]{3}))?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "theme": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Theme"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "ProfileUpdate",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "error"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ResetPasswordRequest": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          },
          "token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "title": "ResetPasswordRequest",
        "type": "object"
      },
      "Role": {
        "description": "Per-workspace role, from most to least privileged.",
        "enum": [
          "owner",
          "admin",
          "editor",
          "viewer"
        ],
        "title": "Role",
        "type": "string"
      },
      "SessionOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current": {
            "title": "Current",
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ip_prefix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Prefix"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "required": [
          "id",
          "created_at",
          "last_seen_at",
          "expires_at",
          "ip_prefix",
          "user_agent",
          "current"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "SessionPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SessionOut"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "SessionPage",
        "type": "object"
      },
      "SetupRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ],
        "title": "SetupRequest",
        "type": "object"
      },
      "SetupStatusResponse": {
        "properties": {
          "needs_setup": {
            "title": "Needs Setup",
            "type": "boolean"
          }
        },
        "required": [
          "needs_setup"
        ],
        "title": "SetupStatusResponse",
        "type": "object"
      },
      "Theme": {
        "enum": [
          "system",
          "light",
          "dark"
        ],
        "title": "Theme",
        "type": "string"
      },
      "UserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "email_verified_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email Verified At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "theme": {
            "$ref": "#/components/schemas/Theme"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "locale",
          "theme",
          "email_verified_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "UserWorkspaceOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/WorkspaceStatus"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "status",
          "role"
        ],
        "title": "UserWorkspaceOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyEmailRequest": {
        "properties": {
          "token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "VerifyEmailRequest",
        "type": "object"
      },
      "WorkspaceStatus": {
        "enum": [
          "active",
          "suspended"
        ],
        "title": "WorkspaceStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "KnoBridge API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/csrf": {
      "get": {
        "description": "Issue a new CSRF token: set as cookie and returned, to echo in ``X-CSRF-Token``.",
        "operationId": "csrf_v1_auth_csrf_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Csrf",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/email/resend": {
      "post": {
        "description": "E-mail a new verification link to the logged-in user.",
        "operationId": "resend_verification_v1_auth_email_resend_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session (standard error shape)."
          },
          "403": {
            "description": "Missing or invalid CSRF token (`csrf_failed`)."
          },
          "409": {
            "description": "The address is already verified (`email_already_verified`)."
          },
          "429": {
            "description": "Too many e-mails requested (`too_many_attempts`)."
          }
        },
        "summary": "Resend Verification",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/email/verify": {
      "post": {
        "description": "Confirm the address with the e-mailed token (works without being logged in).",
        "operationId": "verify_email_v1_auth_email_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid, expired or used token (`invalid_token`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify Email",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/login": {
      "post": {
        "description": "Log in with e-mail and password; on success the cookies carry the new session.",
        "operationId": "login_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid credentials (`invalid_credentials`, generic on purpose)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many failed attempts (`too_many_attempts`)."
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "description": "End the current session and clear its cookies.",
        "operationId": "logout_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session (standard error shape)."
          },
          "403": {
            "description": "Missing or invalid CSRF token (`csrf_failed`)."
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout-all": {
      "post": {
        "description": "End every session of the user on every device, this one included.",
        "operationId": "logout_all_v1_auth_logout_all_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session (standard error shape)."
          },
          "403": {
            "description": "Missing or invalid CSRF token (`csrf_failed`)."
          }
        },
        "summary": "Logout All",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/password/forgot": {
      "post": {
        "description": "Send a reset link if the address has an active account; the answer never tells.",
        "operationId": "forgot_password_v1_auth_password_forgot_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Forgot Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/password/reset": {
      "post": {
        "description": "Set a new password with the e-mailed token; every session of the account ends.",
        "operationId": "reset_password_v1_auth_password_reset_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid, expired or used token (`invalid_token`)."
          },
          "422": {
            "description": "Invalid body or weak password (`weak_password`)."
          }
        },
        "summary": "Reset Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/health/live": {
      "get": {
        "description": "Report that the process is up and serving requests.",
        "operationId": "live_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/health/ready": {
      "get": {
        "description": "Report whether the dependencies needed to serve traffic (the database) answer.",
        "operationId": "ready_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "A dependency is unreachable (standard error shape)."
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "description": "Who is logged in and which workspaces they can open.",
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session (standard error shape)."
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      },
      "patch": {
        "description": "Change name, language or theme; answers like ``GET /v1/me``.",
        "operationId": "update_profile_v1_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session (standard error shape)."
          },
          "403": {
            "description": "Missing or invalid CSRF token (`csrf_failed`)."
          },
          "422": {
            "description": "Invalid body."
          }
        },
        "summary": "Update Profile",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/me/password": {
      "post": {
        "description": "Replace the password; every other session of the user ends, this one stays.",
        "operationId": "change_password_v1_me_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session (standard error shape)."
          },
          "403": {
            "description": "Missing or invalid CSRF token (`csrf_failed`)."
          },
          "422": {
            "description": "Wrong current password (`invalid_current_password`) or weak new password (`weak_password`)."
          }
        },
        "summary": "Change Password",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/me/sessions": {
      "get": {
        "description": "Live sessions of the user, most recently used first; ``current`` marks this one.",
        "operationId": "list_sessions_v1_me_sessions_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session (standard error shape)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Sessions",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/me/sessions/{session_id}": {
      "delete": {
        "description": "End one session of the user (e.g. a lost device); ending this one logs out here.",
        "operationId": "revoke_session_v1_me_sessions__session_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session (standard error shape)."
          },
          "403": {
            "description": "Missing or invalid CSRF token (`csrf_failed`)."
          },
          "404": {
            "description": "No such live session of the user."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke Session",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/setup": {
      "post": {
        "description": "Create the first superadmin (e-mail already verified) and log them in.",
        "operationId": "run_setup_v1_setup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "The instance is already set up (`setup_already_completed`)."
          },
          "422": {
            "description": "Invalid body or weak password (`weak_password`)."
          }
        },
        "summary": "Run Setup",
        "tags": [
          "setup"
        ]
      }
    },
    "/v1/setup/status": {
      "get": {
        "description": "Whether the instance still needs its first setup (no user exists yet).",
        "operationId": "setup_status_v1_setup_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Setup Status",
        "tags": [
          "setup"
        ]
      }
    },
    "/v1/workspaces/{workspace_id}/audit": {
      "get": {
        "description": "Events of the workspace, newest first; the period is ``[occurred_from, occurred_to)``.",
        "operationId": "list_workspace_audit_v1_workspaces__workspace_id__audit_get",
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Workspace Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "action",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/AuditAction"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Action"
            }
          },
          {
            "in": "query",
            "name": "actor_user_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Actor User Id"
            }
          },
          {
            "in": "query",
            "name": "occurred_from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Occurred From"
            }
          },
          {
            "in": "query",
            "name": "occurred_to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Occurred To"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditEventPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session (standard error shape)."
