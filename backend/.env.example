# KnoBridge backend settings. Copy to `.env` (never commit it) and adjust.
# Every variable is read only by src/knobridge/core/settings.py and uses the KNOBRIDGE_ prefix.
# Real environment variables take precedence over values in `.env`.

# Runtime environment: local | test | production.
KNOBRIDGE_ENV=local

# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL. Logs are JSON on stderr.
KNOBRIDGE_LOG_LEVEL=INFO

# Address used by the `knobridge-api` command.
KNOBRIDGE_API_HOST=127.0.0.1
KNOBRIDGE_API_PORT=8000
# Reverse proxies trusted to set X-Forwarded-For/-Proto, as comma-separated IPs or CIDRs ("*"
# trusts any peer: only when nothing but the proxy can reach the API). The client IP, used by
# login throttling, comes from those headers only on requests from one of these addresses;
# otherwise it is the direct peer. Docker Compose sets it to the panel's nginx container.
KNOBRIDGE_FORWARDED_ALLOW_IPS=127.0.0.1

# Origins allowed by CORS, as a JSON list (the admin panel in dev runs on Vite's port).
KNOBRIDGE_CORS_ORIGINS=["http://localhost:5173"]

# Postgres 17 + pgvector DSN, always with the async driver: postgresql+asyncpg://user:pass@host:port/db.
# Used by the API and by Alembic (`uv run alembic upgrade head`).
KNOBRIDGE_DATABASE_URL=postgresql+asyncpg://knobridge:knobridge@localhost:5432/knobridge

# Connection pool per process: steady connections and extra burst connections.
KNOBRIDGE_DATABASE_POOL_SIZE=5
KNOBRIDGE_DATABASE_MAX_OVERFLOW=10

# Seconds to wait when opening a database connection (readiness fails fast past this).
KNOBRIDGE_DATABASE_CONNECT_TIMEOUT=5

# Temporal frontend (host:port) used by `knobridge-worker` (in Docker Compose: temporal:7233).
KNOBRIDGE_TEMPORAL_ADDRESS=localhost:7233
# Temporal namespace that holds KnoBridge workflows.
KNOBRIDGE_TEMPORAL_NAMESPACE=default
# Task queue polled by the worker; KnoBridge workflows and activities run on it.
KNOBRIDGE_TEMPORAL_TASK_QUEUE=knobridge

# Root secret: signs CSRF tokens and derives (HKDF) the keys that encrypt stored secrets such
# as LLM provider API keys; at least 32 characters. Changing it makes those stored keys
# unreadable (re-enter them). Required in production (the API refuses to start with the
# development default). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# KNOBRIDGE_SECRET_KEY=

# Idle lifetime of a login session, ISO 8601 duration (P7D = 7 days, PT8H = 8 hours). Each
# authenticated request pushes the expiry this far ahead (sliding expiration).
KNOBRIDGE_SESSION_TTL=P7D
# Name of the session cookie (httpOnly; holds only an opaque token).
KNOBRIDGE_SESSION_COOKIE_NAME=knobridge_session
# Mark cookies Secure (HTTPS only). Browsers accept Secure cookies on http://localhost too;
# set false only to test from another host over plain HTTP.
KNOBRIDGE_COOKIE_SECURE=true

# Login throttling: failed attempts allowed per e-mail + client IP inside one window (ISO 8601
# duration, counted from the first failure). Past the limit, login answers 429 until the
# window ends, even with the right password.
KNOBRIDGE_LOGIN_MAX_ATTEMPTS=5
KNOBRIDGE_LOGIN_ATTEMPT_WINDOW=PT15M

# Validity of the single-use links sent by e-mail (ISO 8601 durations).
KNOBRIDGE_PASSWORD_RESET_TTL=PT1H
KNOBRIDGE_EMAIL_VERIFICATION_TTL=PT24H
KNOBRIDGE_INVITATION_TTL=P7D
# E-mails of each kind (password reset, e-mail verification) one address may trigger inside
# one window. Past the limit, "forgot password" still answers the same but sends nothing, and
# "resend verification" answers 429.
KNOBRIDGE_ACCOUNT_EMAIL_MAX_REQUESTS=3
KNOBRIDGE_ACCOUNT_EMAIL_WINDOW=PT1H

# Absolute URL of the admin panel (scheme + host, optional port). Links in e-mails (password
# reset, e-mail verification, invitation, initial password) point to pages under it.
KNOBRIDGE_PUBLIC_BASE_URL=http://localhost:5173

# Outgoing SMTP server for transactional e-mail. The defaults match Mailpit from
# deploy/docker-compose.yml (SMTP on localhost:1025, web UI on http://localhost:8025).
KNOBRIDGE_SMTP_HOST=localhost
KNOBRIDGE_SMTP_PORT=1025
# Login only happens when a user is set; leave both empty for Mailpit.
# KNOBRIDGE_SMTP_USER=
# KNOBRIDGE_SMTP_PASSWORD=
# Sender of every e-mail ("Name <address>").
KNOBRIDGE_SMTP_FROM=KnoBridge <no-reply@knobridge.local>
# Upgrade the connection with STARTTLS (true for most providers on port 587; false for Mailpit).
KNOBRIDGE_SMTP_STARTTLS=false
# Seconds to wait for the SMTP server on each operation.
KNOBRIDGE_SMTP_TIMEOUT=10

# Embedding prices in USD per million input tokens, as a JSON object keyed by model id; used
# for the estimated cost of indexing runs. Merged over the built-in table
# (src/knobridge/llm/pricing.py: text-embedding-3-small 0.02, text-embedding-3-large 0.13,
# text-embedding-ada-002 0.10, each also under the "openai/" prefix OpenRouter uses). A model
# without a price shows an unknown cost, never zero.
# KNOBRIDGE_EMBEDDING_PRICES={"openai/text-embedding-3-small": 0.02}

# Folder and local Git sources must live under this directory; a source path outside it, or
# escaping it through ".." or a symlink, is refused. Docker Compose mounts the host's sources
# folder here, read-only. Running the worker outside Docker, point it at your own folder.
KNOBRIDGE_LOCAL_SOURCES_ROOT=/sources
# Files larger than this many bytes are skipped when selecting what to index (2 MiB).
KNOBRIDGE_MAX_SOURCE_FILE_BYTES=2097152
# Same limit for PDF and Office documents (.pdf, .docx, .xlsx, .pptx), which are binary but
# converted to Markdown by the parser (20 MiB).
KNOBRIDGE_MAX_SOURCE_DOCUMENT_BYTES=20971520
