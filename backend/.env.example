# KnoBridge backend settings. Copy to `.env` (never commit it) and adjust.
# Every variable is read only by src/knobridge/core/settings.py and uses the KNOBRIDGE_ prefix.
# Real environment variables take precedence over values in `.env`.

# Runtime environment: local | test | production.
KNOBRIDGE_ENV=local

# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL. Logs are JSON on stderr.
KNOBRIDGE_LOG_LEVEL=INFO

# Address used by the `knobridge-api` command.
KNOBRIDGE_API_HOST=127.0.0.1
KNOBRIDGE_API_PORT=8000

# Origins allowed by CORS, as a JSON list (the admin panel in dev runs on Vite's port).
KNOBRIDGE_CORS_ORIGINS=["http://localhost:5173"]

# Postgres 17 + pgvector DSN, always with the async driver: postgresql+asyncpg://user:pass@host:port/db.
# Used by the API and by Alembic (`uv run alembic upgrade head`).
KNOBRIDGE_DATABASE_URL=postgresql+asyncpg://knobridge:knobridge@localhost:5432/knobridge

# Connection pool per process: steady connections and extra burst connections.
KNOBRIDGE_DATABASE_POOL_SIZE=5
KNOBRIDGE_DATABASE_MAX_OVERFLOW=10

# Seconds to wait when opening a database connection (readiness fails fast past this).
KNOBRIDGE_DATABASE_CONNECT_TIMEOUT=5

# Temporal frontend (host:port) used by `knobridge-worker` (in Docker Compose: temporal:7233).
KNOBRIDGE_TEMPORAL_ADDRESS=localhost:7233
# Temporal namespace that holds KnoBridge workflows.
KNOBRIDGE_TEMPORAL_NAMESPACE=default
# Task queue polled by the worker; KnoBridge workflows and activities run on it.
KNOBRIDGE_TEMPORAL_TASK_QUEUE=knobridge
