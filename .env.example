# KnoBridge Docker Compose settings. Copy to .env at the repository root (ignored by git) and adjust.
# Every variable is optional: docker-compose.yml has the same defaults, so `up` works without .env.
#
# !!! DEVELOPMENT ONLY !!! The credentials below are public, well-known values for a local
# environment. Never use them in a shared, staging or production environment.

# Interface the host ports bind to. 127.0.0.1 keeps every service off the network;
# use 0.0.0.0 only if you really need to reach them from another machine.
BIND_ADDRESS=127.0.0.1

# Host ports (change any that are already taken on your machine).
POSTGRES_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
FRONTEND_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Fake ticket system of the E2E stack only (docker-compose.e2e.yml, service webhook-sink).
WEBHOOK_SINK_PORT=8090

# Postgres superuser (used only by the init script and for manual administration). DEV ONLY.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres-dev

# KnoBridge application database and role, created on the first start. DEV ONLY.
# Changing them after the first `up` requires `down -v` (the init script runs on an empty volume only).
KNOBRIDGE_DB_NAME=knobridge
KNOBRIDGE_DB_USER=knobridge
KNOBRIDGE_DB_PASSWORD=knobridge-dev

# Role that owns the Temporal databases (temporal, temporal_visibility). DEV ONLY.
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal-dev

# Temporal namespace registered by auto-setup and used by the worker.
TEMPORAL_NAMESPACE=default
KNOBRIDGE_TEMPORAL_TASK_QUEUE=knobridge

# MinIO (S3-compatible object storage) root credentials, also the console login. DEV ONLY.
MINIO_ROOT_USER=knobridge
MINIO_ROOT_PASSWORD=knobridge-dev
# MinIO image (pinned release). Override only to test another release.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# Host folder with the folder and local Git sources to index, mounted read-only at /sources in
# the api and the worker (register sources as /sources/<subfolder>). Absolute, or relative to
# the repository root. The default deploy/sources/ is ignored by git, so nothing you put there is committed.
# Repositories given by https URL are cloned into the named volume source-clones instead.
KNOBRIDGE_SOURCES_DIR=./deploy/sources

# Backend log level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
KNOBRIDGE_LOG_LEVEL=INFO

# Secret that signs CSRF tokens (32+ characters). DEV ONLY: this is the public development
# default; anywhere beyond your machine, replace it with the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KNOBRIDGE_SECRET_KEY=dev-only-insecure-secret-key-change-me

# URL of the admin panel as the browser sees it; links in e-mails start here.
# Keep the port in sync with FRONTEND_PORT.
KNOBRIDGE_PUBLIC_BASE_URL=http://localhost:5173

# Sender of transactional e-mails. In this environment every e-mail goes to Mailpit
# (http://localhost:8025) and nothing is delivered to real mailboxes.
KNOBRIDGE_SMTP_FROM=KnoBridge <no-reply@knobridge.local>

# Backend environment: local | test | production. Anything but production allows the `fake`
# LLM provider; production also requires a real KNOBRIDGE_SECRET_KEY.
# docker-compose.e2e.yml always pins local.
KNOBRIDGE_ENV=local

# DEV ONLY: cookies without the Secure flag, because this stack serves the panel over plain
# HTTP. Behind HTTPS, set true (the application default).
KNOBRIDGE_COOKIE_SECURE=false

# Hosts (exact names, comma-separated) the ticket webhooks of assistants may reach over http and
# without the SSRF checks (docs/specs/chamados.md, "Abrir chamado"). Keep it empty: destinations
# must be public https. docker-compose.e2e.yml sets it to its fake destination, webhook-sink.
KNOBRIDGE_WEBHOOK_ALLOWED_HOSTS=

# Chat prices in USD per million tokens, JSON keyed by the model id as the assistant stores it,
# with both prices per model. Merged over the built-in table (Claude, GPT-4.1 and GPT-4o, plain
# and with the OpenRouter prefix); add the models you use that are missing there, or Usage and
# costs shows their answers as "custo parcial". Changing it never recalculates past answers.
# Example (single quotes keep the JSON as is): KNOBRIDGE_CHAT_PRICES='{"openai/gpt-4.1-mini": {"input": 0.40, "output": 1.60}}'
KNOBRIDGE_CHAT_PRICES={}

# Default similarity floor of the search per embedding model, as JSON, from 0 to 1
# (docs/specs/indexacao.md, "Limiar por modelo de embedding"). Merged over the built-in table
# (text-embedding-3-* 0.35, gemini-embedding-001 0.60, gemini-embedding-2 0.57; any other model
# 0.35); the vendor prefix and the case are ignored. Holds for products whose min_similarity is
# null. Example: KNOBRIDGE_MIN_SIMILARITY_DEFAULTS='{"gemini-embedding-001": 0.62}'
KNOBRIDGE_MIN_SIMILARITY_DEFAULTS={}

# MCP server at /v1/mcp (docs/specs/mcp.md, docs/guias/conectar-pelo-mcp.md). Host values the
# endpoint accepts, comma-separated (`host:*` = any port); empty: the host of
# KNOBRIDGE_PUBLIC_BASE_URL, localhost:* and 127.0.0.1:*. Fill it when another name or port
# reaches the API (a proxy in front of it), e.g. kb.empresa.com,kb.interno:*
KNOBRIDGE_MCP_ALLOWED_HOSTS=
# Browser origins allowed to call /v1/mcp (`https://host[:port]`, comma-separated). Empty: every
# request with an Origin header is refused (IDE and terminal clients send none).
KNOBRIDGE_MCP_ALLOWED_ORIGINS=

# Embeddable widget (docs/specs/widget.md, docs/guias/embutir-o-widget.md): limits of the public
# routes per widget and client IP (every request per minute, new conversations and ticket
# requests per hour; questions per IP and per day are set per widget in the panel) and the clock
# tolerance, in seconds (0 to 600), of the signed visitor identity.
KNOBRIDGE_WIDGET_REQUESTS_PER_MINUTE=120
KNOBRIDGE_WIDGET_CONVERSATIONS_PER_HOUR=20
KNOBRIDGE_WIDGET_TICKETS_PER_HOUR=5
KNOBRIDGE_WIDGET_IDENTITY_CLOCK_SKEW=60

# Optional reranker (docs/specs/indexacao.md, "Reranker"; ADR 0011), off by default. The compose
# service `reranker` (profile `reranker`) runs Text Embeddings Inference on CPU with
# BAAI/bge-reranker-v2-m3: slow on CPU (tens of seconds for 30 passages) and about 6 to 8 GB of
# memory. To turn it on, set KNOBRIDGE_RERANKER_URL=http://reranker:80 and run
# `docker compose --profile reranker up -d`. The first start downloads the model (about 2.3 GB)
# into the reranker-models volume. On ARM, use the image tag cpu-arm64-1.9.4.
RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.4
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
# Commit of the model repository on Hugging Face (pinned so every start loads the same weights).
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RERANKER_MEMORY_LIMIT=8g
# Where the API calls the reranker; empty (the default): the instance has no reranker and
# searches keep the RRF order. Timeout in seconds (1 to 60), candidates sent after the fusion
# (10 to 100) and characters per text sent (200 to 8000). KNOBRIDGE_RERANKER_MODEL is only the
# name shown in the instance health.
KNOBRIDGE_RERANKER_URL=
KNOBRIDGE_RERANKER_TIMEOUT=10
KNOBRIDGE_RERANKER_CANDIDATES=30
KNOBRIDGE_RERANKER_MAX_CHARS=2000
KNOBRIDGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Compose network and the fixed address of the panel's nginx, the reverse proxy of /v1.
# FRONTEND_IPV4 must be inside COMPOSE_SUBNET; change both if the subnet overlaps a network of
# your machine or of another running stack (e.g. the dev and the e2e stacks at the same time).
# Keep FRONTEND_IPV4 high in the subnet: Docker gives the other containers addresses from .2 up.
COMPOSE_SUBNET=10.213.57.0/24
FRONTEND_IPV4=10.213.57.250
# Proxies whose X-Forwarded-For the API trusts (IPs or CIDRs, comma-separated). The client IP,
# used by login throttling, comes from that header only on requests from them; by default only
# the panel's nginx (FRONTEND_IPV4). Requests straight to API_PORT count the direct peer.
KNOBRIDGE_FORWARDED_ALLOW_IPS=10.213.57.250
